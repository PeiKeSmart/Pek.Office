<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>..\Bin\UnitTest</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="excel.xlsx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="excel.xlsx">
      <LogicalName>XUnitTest.excel.xlsx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Markdown 测试夹具：复制到输出目录供真实文件测试使用 -->
  <ItemGroup>
    <None Include="Markdown\Fixtures\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="DH.NCore" Version="4.25.2026.911-beta0202" />
    <PackageReference Include="DH.UnitTest" Version="4.25.2026.914-beta0328" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 竞品交叉兼容测试依赖（仅测试项目，不污染生产代码） -->
  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <!-- 覆盖 NPOI 2.8.0 传递依赖中的已知漏洞版本（仅测试项目）：
       NPOI → Microsoft.SourceLink.GitHub 8.0.0 → Microsoft.Build.Tasks.Git 8.0.0（中危 GHSA-23fw-v26w-5fgq）；
       NPOI → System.Security.Cryptography.Xml 8.0.2（高危，多个 GHSA） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

  <!-- Word 真实文件回归库：从 Bin 复制到测试输出，供往返/交叉测试使用 -->
  <ItemGroup>
    <None Include="Word\Fixtures\**\*.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pek.Office\Pek.Office.csproj" />
    <ProjectReference Include="..\Pek.Office.Cli\Pek.Office.Cli.csproj" />
  </ItemGroup>

  <!-- Rendering 渲染扩展包测试（独立 NuGet 扩展，依赖 SkiaSharp；仅测试项目引用，不污染生产代码） -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pek.Office.Rendering\Pek.Office.Rendering.csproj" />
  </ItemGroup>

</Project>
